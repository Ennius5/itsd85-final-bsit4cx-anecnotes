# Copy to .env and replace every value. Never commit .env (Q5).

# --- App ---
APP_NAME=Anecnotes
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_--show
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_VERSION=dev
FRONTEND_URL=http://localhost:8080
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (PostgreSQL 17 container) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=anecnotes
DB_USERNAME=anecnotes
DB_PASSWORD=change-me

# --- Sessions, cache, queue ---
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Auth ---
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080
LOGIN_MAX_ATTEMPTS=5

# Password for the seeded demo accounts (php artisan db:seed). Sample data only.
DEMO_PASSWORD=change-me-demo

# --- AI provider: any OpenAI-compatible endpoint (T1) ---
# Main: Groq free tier. Backup: OpenRouter free models.
# Real school use: a local llama.cpp / Ollama server, e.g. AI_BASE_URL=http://ollama:11434/v1
AI_ENABLED=true
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
AI_API_KEY=gsk_dummy_replace_me
AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_MODEL=google/gemma-4-31b-it:free
AI_FALLBACK_API_KEY=sk-or-dummy_replace_me
AI_TIMEOUT_SECONDS=20
AI_MAX_REQUESTS_PER_MINUTE=25

# --- Repeated-behavior rule ---
FLAG_MIN_COUNT=3
FLAG_WINDOW_DAYS=30
FLAG_TRGM_THRESHOLD=0.35

# --- Attendance ---
ATTENDANCE_EDIT_WINDOW_MINUTES=15

# --- Public URL (Cloudflare Tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=dummy-tunnel-token
